# Argus Forge independent app (apps/forge) — local env example
# Copy to .env.local in this directory.

# Transitional credential (same as monolith Argus gate during migration)
# ARGUS_PASSWORD=change-me-argus
# Legacy alias still accepted:
# HEALTH_VAULT_PASSWORD=change-me-argus

# Cookie Secure flag: set 0 when using `next start` over http://localhost
# FORGE_COOKIE_SECURE=0

# Cross-product URL bases (local defaults if unset: http://localhost:3002)
# NEXT_PUBLIC_MATRIXTRADE_URL=http://localhost:3002
# NEXT_PUBLIC_ARGUS_URL=http://localhost:3002
