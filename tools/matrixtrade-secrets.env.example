# Prompt #12D — local Supabase credentials (never commit this file).
# Copy from Vercel → matrix-trade → Settings → Environment Variables (Production).
# Save as: %USERPROFILE%\.matrixtrade\secrets.env

TRADES_STORE=supabase-readonly
MXT_READ_ONLY=1

